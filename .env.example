# Copy to `.env`. Every value below is optional except the tunnel token, and
# that one is only read by the `tunnel` profile.

# Host directory holding config, media and torrents. Mounted at the same path
# inside the container, so every path set in the wizard must live under it.
STUPEFLIX_ROOT=/srv/stupeflix

# Ownership applied to the service containers. Match the user that owns
# STUPEFLIX_ROOT — a mismatch rewrites the generated compose file on every
# switch and recreates every container.
PUID=1000
PGID=1000

TZ=Europe/Paris

# Cloudflare Zero Trust → Networks → Tunnels → your tunnel → copy the token.
# Required by `docker compose --profile tunnel up -d`, ignored otherwise.
CLOUDFLARE_TUNNEL_TOKEN=
