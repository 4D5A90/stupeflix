# Copy to `.env`. Every value below is optional except the tunnel token, and
# that one is only read by the `tunnel` profile.

# Host directory holding config, media and torrents. Mounted at the same path
# inside the container, so every path set in the wizard must live under it.
STUPEFLIX_ROOT=/srv/stupeflix

# Ownership applied to the service containers. Match the user that owns
# STUPEFLIX_ROOT — a mismatch rewrites the generated compose file on every
# switch and recreates every container.
PUID=1000
PGID=1000

TZ=Europe/Paris

# Access token for the wizard and the API. **Set one here.** Left empty it still
# works — one is minted on first boot and printed in the container log — but that
# copy is only as durable as your logs, and the token itself then lives in a
# SQLite blob. Written here it stays readable to anyone who can already reach the
# machine, which is exactly who is allowed to know it.
#   openssl rand -base64 32
# Letters, digits and . _ ~ + / - = only, 16 characters minimum. The server
# refuses to start on anything else rather than start unreachable.
STUPEFLIX_TOKEN=

# Where a browser opens the services, when the dashboard is reached through a
# reverse proxy on another machine (the page's host would then be the proxy).
# A bare host, no scheme or port. A .env file takes no $(...), so to compute it
# leave this empty and export it from the shell instead:
#   STUPEFLIX_PUBLIC_HOST=$(ipconfig getifaddr en0) docker compose up -d
STUPEFLIX_PUBLIC_HOST=

# Cloudflare Zero Trust → Networks → Tunnels → your tunnel → copy the token.
# Required by `docker compose --profile tunnel up -d`, ignored otherwise.
CLOUDFLARE_TUNNEL_TOKEN=
